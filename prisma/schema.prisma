// 化学物質管理システム v2 — Prisma スキーマ
//
// ここには「そのステップで確定した分だけ」を置き、機能ごとにマイグレーションを分けて積み上げる。
//
// 共通ルール（CLAUDE.md §4）:
// - provider は postgresql を既定とし、mysql / sqlserver へ切替可能な書き方を保つ。
// - 数値（含有率・閾値・係数）は Decimal。Float 禁止。桁は S5 で確定する。
// - code / cas は *_normalized 列（trim＋大文字化）で突合・一意判定する（照合順序差の吸収）。
// - created_by / updated_by は User.id を保持するが、リレーション爆発を避けるため
//   物理FKは張らずアプリ層で整合を担保する。
// - Prisma は 6 系に固定（7 系は datasource url の設定方式が変わる）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // 切替: "mysql" / "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------- Enum ----------

/**
 * 権限。役割ではなく権限そのものをユーザーに持たせる。
 * packages/shared/src/permissions.ts の PERMISSIONS と必ず一致させること。
 */
enum Permission {
  PRODUCT_VIEW
  PRODUCT_EDIT
  COMPOSITION_VIEW
  SUBSTANCE_VIEW
  SUBSTANCE_EDIT
  INACTIVE_VIEW
  INACTIVE_EDIT
  APPROVE
  REGULATION_VIEW
  REGULATION_EDIT
  DATA_EXPORT
  DOC_TEMPLATE_EDIT
  DOCUMENT_CREATE
  DOCUMENT_SENDER
  ORG_EDIT
  NEWS_POST
  NEWS_MANAGE
  ADMIN
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/**
 * 公開の状態。作った直後は作成中で、他の人には見せない。
 * 承認が必要かどうかはシステム設定で切り替える（不要なら「発行」で直接公開する）。
 * 廃番かどうか（status）とは別の軸。
 */
enum PublishState {
  DRAFT
  PENDING
  REJECTED
  PUBLISHED
}

/**
 * 承認の履歴に残す操作
 */
enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
  UNPUBLISH
}

enum SubstanceStatus {
  ACTIVE
  DISCONTINUED
}

/**
 * 官報公示整理番号の法令区分。CSCL（化審法）の番号が通称 MITI番号
 */
enum GazetteLawKind {
  CSCL
  ISHA
  OTHER
}

/**
 * 拡張属性の項目定義が、物質と製品のどちらのものか
 */
enum PropertyTarget {
  SUBSTANCE
  PRODUCT
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
}

enum PropertyDataType {
  NUMBER
  TEXT
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

/**
 * グループの用途。
 * NEWS = ホームのお知らせを見出しで区切るための分類
 * ORG  = 組織の所属（○○部 など）
 * 用途ごとに表を分けず種別で持つのは、管理画面と操作をひとつにまとめられるため。
 */
/**
 * 組織の種別。
 * **会社も部署も取引先も、同じ1つの表に入れる。**
 * どれも「名前と項目を持ち、帳票に差し込める入れもの」で、作りが変わらない。
 * 分けて持つと、取引先にだけ住所が書けない、といった食い違いが出る。
 */
enum OrganisationKind {
  /**
   * 会社。自社も関連会社もこれ
   */
  COMPANY
  /**
   * 部署
   */
  DEPARTMENT
  /**
   * 取引先
   */
  PARTNER
  /**
   * そのほか。呼び名は `kindLabel` に打ってもらう
   */
  OTHER
}

enum GroupKind {
  NEWS
  ORG
}

// ---------- ユーザー・セッション ----------

model User {
  id                 String    @id @default(cuid())
  /**
   * ログインID（メールアドレス）。小文字化して保存・突合する
   */
  email              String    @unique
  /**
   * Argon2id パスワードハッシュ。null=未発行（管理者が発行するまでログイン不可）
   */
  passwordHash       String?   @map("password_hash")
  /**
   * 次回ログイン時にパスワード変更を強制する（初期パスワード発行時に true）
   */
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /**
   * 連続ログイン失敗回数（総当たり対策）
   */
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  /**
   * この日時までログイン試行を拒否（ロックアウト）
   */
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  /**
   * TOTP（多要素認証）の秘密鍵。null=MFA未設定
   */
  mfaSecret          String?   @map("mfa_secret")
  /**
   * 2要素認証のやりかた。none（使わない）/ totp（認証アプリの6桁）。
   * 真偽値ではなく方式で持つのは、将来メール認証を足せるようにするため。
   * 登録の途中（鍵は作ったが6桁の確認がまだ）は mfaSecret だけが入り、ここは none のまま
   */
  mfaMethod          String    @default("none") @map("mfa_method") @db.VarChar(20)

  /**
   * フィードバックを最後に見た時刻。これより後の書き込み・返事が「未読」。
   * 一度も開いていない人は null（＝全部が未読）
   */
  feedbackSeenAt        DateTime? @map("feedback_seen_at")
  displayName           String?   @map("display_name")
  /**
   * アバター画像の中身と種類。アプリ側のファイルは配置のたびに消えるため、DBに持つ。
   * 一覧に出すものではないので、必要な画面から個別に取りに来る
   */
  avatarData            Bytes?    @map("avatar_data")
  avatarMime            String?   @map("avatar_mime") @db.VarChar(50)
  /**
   * 画像が変わった日時。ブラウザの持っている絵を捨てさせるために使う
   */
  avatarUpdatedAt       DateTime? @map("avatar_updated_at")
  /**
   * 表示言語の ISO コード（"ja" / "en"）。null=未設定（既定言語を使う）
   */
  preferredLocale       String?   @map("preferred_locale")
  /**
   * 画面のテーマ（"system" / "light" / "dark" など）。null=未設定
   */
  preferredTheme        String?   @map("preferred_theme")
  /**
   * ヘッダーなどを濃くするか。null=未設定（既定=しない）
   */
  preferredHeaderStrong Boolean?  @map("preferred_header_strong")
  /**
   * 背景の模様・挿絵（"none" / "grid" など）。null=未設定
   */
  preferredBackground   String?   @map("preferred_background")
  /**
   * 1ページの件数の好み。`15,25,50,100|50` の形（選択肢｜既定）。
   * 画面の高さも読みたい量も人によって違うので、決め打ちにしない
   */
  preferredPageSizes    String?   @map("preferred_page_sizes")
  /**
   * 組織の所属。1人1つ。null=未所属
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * お知らせの分類。1人1つ。NEWS_POST を持つ人にだけ意味がある
   */
  newsGroupId           String?   @map("news_group_id")
  activeFlag            Boolean   @default(true) @map("active_flag")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  sessions      Session[]
  permissions   UserPermission[]
  savedFilters  SavedFilter[]
  news          News[]
  passkeys      Passkey[]
  newsGroup     Group?             @relation("UserNewsGroup", fields: [newsGroupId], references: [id])
  /**
   * 所属する組織。**種別を問わず何件でも。**
   * 帳票の差出人には種別「会社」の先頭、お知らせの所属には「部署」の先頭を使う
   */
  organisations UserOrganisation[]

  @@index([newsGroupId])
  @@map("users")
}

/**
 * パスキー（WebAuthn）。**端末そのものが鍵になる。**
 * 保存するのは公開鍵だけ。秘密の鍵は端末から出てこないので、
 * この表が丸ごと漏れても、それだけでは誰も入れない。
 * **偽サイトに引っかからない。**鍵は登録したドメインに縛られていて、
 * そっくりの偽ログイン画面では署名が出ない。
 * 認証アプリの6桁は打ち込めてしまうので、ここが本質的な差になる。
 * 1人が複数の端末を登録できる。1台失くしても、別の端末から入り直せる。
 */
model Passkey {
  id String @id @default(cuid())

  userId       String  @map("user_id")
  /**
   * 端末が付けた鍵の名前（base64url）。ログインのときはこれで人を引く
   */
  credentialId String  @unique @map("credential_id")
  /**
   * 公開鍵。署名を確かめるのに使う
   */
  publicKey    Bytes   @map("public_key")
  /**
   * 端末が数える使用回数。**戻ったり据え置かれたら、鍵の複製を疑う**
   * （数えない端末もあるので、0のままなら見ない）
   */
  counter      BigInt  @default(0)
  /**
   * 内蔵か、USBか、スマートフォンか。次に出すときの案内に使う
   */
  transports   String?

  /**
   * 本人が付ける名前（「会社のPC」など）。どれを消すか選べるようにするため
   */
  deviceLabel String    @map("device_label")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/**
 * 組織（会社・事業所）。**帳票に載せる差出人の情報を置く。**
 * 持つ項目は決めない。会社名・住所・電話・登録番号・担当窓口…と、
 * 業種や提出先によって求められるものが違うので、**項目名も値も打ってもらう**。
 * 列を決め打ちすると、必ず「その列に無いもの」が出てきて、備考に押し込むことになる。
 * 取引先（提出先）はここに入れない。件数も寿命も違うので、必要になったら別に持つ。
 */
model Organisation {
  id        String           @id @default(cuid())
  code      String           @unique
  /**
   * 会社・部署・取引先・そのほか。一覧で絞る単位でもある
   */
  kind      OrganisationKind @default(COMPANY)
  /**
   * `OTHER` のときの呼び名（「工場」「協同組合」など）。
   * **決まった4つに収まらないものを、そのまま呼べるようにする。**
   * ほかの種別では使わない
   */
  kindLabel String?          @map("kind_label")

  nameJa       String    @map("name_ja")
  nameEn       String?   @map("name_en")
  displayOrder Int       @default(0) @map("display_order")
  activeFlag   Boolean   @default(true) @map("active_flag")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  items   OrganisationItem[]
  /**
   * この組織に所属する人
   */
  members UserOrganisation[]

  @@index([displayOrder])
  @@map("organisations")
}

/**
 * 組織の項目。**項目名も値も自由入力。**
 * 帳票からは項目名で引く（`org.item.会社名` のように）。
 * そのため同じ組織の中で項目名は重ならないようにする
 */
model OrganisationItem {
  id             String @id @default(cuid())
  organisationId String @map("organisation_id")
  label          String
  value          String
  displayOrder   Int    @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, label])
  @@index([organisationId, displayOrder])
  @@map("organisation_items")
}

/**
 * ユーザーと組織の結び付き。**1人が種別を問わず何件でも持てる。**
 * 会社1つ・部署1つの2枠に分けていたのをやめた（2026-09-03）。
 * どれを帳票の差出人・お知らせの所属に使うかは、種別と組織の表示順で決める
 */
model UserOrganisation {
  userId         String @map("user_id")
  organisationId String @map("organisation_id")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([userId, organisationId])
  @@index([organisationId])
  @@map("user_organisations")
}

/**
 * グループ（お知らせの分類 / 組織の所属）。
 * 階層は持たない。並列に作り、表示順で並べる。
 */
model Group {
  id           String    @id @default(cuid())
  kind         GroupKind
  nameJa       String    @map("name_ja")
  /**
   * 英語は任意。未入力なら英語表示でも日本語を出す
   */
  nameEn       String?   @map("name_en")
  /**
   * 小さいほど先。お知らせの見出しの並び順にもなる
   */
  displayOrder Int       @default(0) @map("display_order")
  activeFlag   Boolean   @default(true) @map("active_flag")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  newsMembers User[] @relation("UserNewsGroup")
  news        News[]

  @@index([kind, displayOrder])
  @@map("groups")
}

/**
 * ユーザーが持つ権限。
 * 含意（編集できるなら見られる 等）は保存前に展開しておくので、
 * 判定側はこの表に行があるかどうかだけを見ればよい。
 */
model UserPermission {
  userId     String     @map("user_id")
  permission Permission
  grantedAt  DateTime   @default(now()) @map("granted_at")
  grantedBy  String?    @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

/**
 * ログインセッション（自前認証・外部サービスに一切依存しない）。
 * Cookie には推測不能なトークンのみを入れ、DBにはその SHA-256 ハッシュだけを保存する。
 */
model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @map("token_hash")
  userId      String    @map("user_id")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  /**
   * 監査用（どの端末からのセッションか）
   */
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  /**
   * 切れた日時。**切るときに行を消さず、印を付けるだけにする。**
   * 消してしまうと「なぜ切れたのか」が残らず、
   * ログイン画面で「一定時間操作がなかったため」としか言えなくなる
   */
  endedAt     DateTime? @map("ended_at")
  /**
   * 切れた理由。settings（設定が変わった）/ expired（期限切れ）/
   * idle（放置）/ logout（自分で出た）
   */
  endedReason String?   @map("ended_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------- システム設定・監査 ----------

model SystemSetting {
  id           String           @id @default(cuid())
  key          String           @unique
  value        String?
  valueType    SettingValueType @map("value_type")
  defaultValue String?          @map("default_value")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  updatedBy    String?          @map("updated_by")

  @@map("system_settings")
}

/**
 * 物質のスコアを、どの段（ランク）に読み替えるかの表。**システム設定の一部**。
 * 段の数は決めない。何段でも足せる。
 * 段の名前は数字でなくてよい（`A` `要注意` など）。
 * 上下の境目は**値と不等号**で持つ。`0 ≦ x < 30` と `30 ≦ x < 70` のように
 * 隣どうしで同じ値を使えるようにするため、含む・含まないを段ごとに決められる。
 * 値が空なら、その側に限りが無い（`x < 30` や `100 ≦ x`）。
 */
model SubstanceRankBand {
  id String @id @default(cuid())

  /**
   * 画面に出す段の名前。数字でなくてよい
   */
  label String @db.VarChar(50)

  /**
   * 下限。空なら下限なし
   */
  lowerValue Decimal?        @map("lower_value") @db.Decimal(12, 3)
  lowerBound ThresholdBound? @map("lower_bound")

  /**
   * 上限。空なら上限なし
   */
  upperValue Decimal?        @map("upper_value") @db.Decimal(12, 3)
  upperBound ThresholdBound? @map("upper_bound")

  /**
   * 並び順。**上から順に当てはめ、最初に合った段を採る**
   */
  displayOrder Int @default(0) @map("display_order")

  note String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  @@index([displayOrder])
  @@map("substance_rank_bands")
}

model AuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String?  @map("entity_id")
  action   String // create / update / delete / login / determine / import / export ...
  actorId  String?  @map("actor_id")
  at       DateTime @default(now())
  /**
   * 変更差分（表示専用。条件検索・並べ替えには使わない）
   */
  diff     Json?

  @@index([entity, entityId])
  @@index([actorId, at])
  @@map("audit_logs")
}

/**
 * 組成を末端まで下ろして、CAS でまとめた結果。**製品ごとに保持する。**
 * 求められるたびに計算する形では、次のことができない。
 * - 「この物質を含む製品を全部出せ」という逆引き
 * - 全製品への一括判定
 * - 判定結果を持っておくこと（土台がその都度変わってしまう）
 * **権限は見ない。**全部見える前提で1通りだけ作り、見せるときに絞る。
 * 見る人によって中身が変わると、人によって違う判定結果ができてしまう。
 * 組成が変わったら作り直す。**変わった製品だけでは足りない**（それを原材料に
 * 使っている親製品すべてを、何段でも上へたどって作り直す）。
 */
model ProductExpansion {
  productId String @id @map("product_id")

  /**
   * 展開できたぶんの合計。すべて展開できていれば 100 になる
   */
  totalPct   Decimal @map("total_pct") @db.Decimal(9, 6)
  /**
   * 中身が分からないまま残ったぶんの合計。
   * **0 でなければ判定は言い切れない。**「要確認」にする根拠になる
   */
  unknownPct Decimal @map("unknown_pct") @db.Decimal(9, 6)
  /**
   * 深さの上限で打ち切った枝の数。0 でなければ不完全
   */
  truncated  Int     @default(0)

  computedAt DateTime @default(now()) @map("computed_at")

  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   ProductExpansionLine[]

  @@map("product_expansions")
}

/**
 * 展開結果の1行。CAS 単位でまとめたもの。
 * CAS を持たない物質はまとめようがないので、物質そのものを鍵にする
 * （その場合 casNormalized は空で、substanceId が入る）。
 * 名前は持たない。物質マスターを引けば分かるものを二重に持つと、必ず食い違う。
 */
model ProductExpansionLine {
  id        String @id @default(cuid())
  productId String @map("product_id")

  /**
   * CAS でまとめたもの。持たない物質のときは空
   */
  casNormalized String? @map("cas_normalized") @db.VarChar(20)
  /**
   * CAS を持たない物質のときだけ入る
   */
  substanceId   String? @map("substance_id")

  /**
   * 製品全体に対する重量％
   */
  totalPct Decimal @map("total_pct") @db.Decimal(9, 6)

  expansion ProductExpansion @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, casNormalized, substanceId])
  // 逆引き（この CAS を含む製品を全部出す）で引く
  @@index([casNormalized])
  @@index([substanceId])
  @@map("product_expansion_lines")
}

/**
 * 製品ごと・区分ごとの判定結果。**保持する。**
 * 判定と「人が見たかどうか」を**別々に持つ**。
 * 「答えは何か」と「確認が済んでいるか」は別の話で、混ぜると
 * 「見たけれど答えは変わらない」という結論の置き場所が無くなる。
 * **前提が変わったら、この行ごと作り直す。**
 * 組成が変われば、前の判定も確認済みの状態も上書きも、すべて捨てる。
 * 新しい製品を判定するのと同じ。判定だけやり直して確認結果が残るのは筋が通らない。
 * 「いつ誰が何をしたか」はアクセス記録の側に残るので、追うことはできる。
 */
model ProductJudgement {
  id         String @id @default(cuid())
  productId  String @map("product_id")
  categoryId String @map("category_id")

  verdict JudgementVerdict
  source  JudgementSource  @default(SYSTEM)

  /**
   * 人が見なければ決められない、という印。
   * 確認すると OFF になる（判定を変えなくてもよい）
   */
  needsReview   Boolean  @default(false) @map("needs_review")
  /**
   * なぜ要確認なのか。機械が読める符号を並べる（文言は画面側で付ける）
   */
  reviewReasons String[] @map("review_reasons")

  /**
   * 確認・上書きをした人。していなければ空
   */
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")
  /**
   * そう判断した根拠。監査で問われたときに答えられるようにする
   */
  decidedNote String?   @map("decided_note")

  computedAt DateTime @default(now()) @map("computed_at")
  /**
   * どの法規制バージョンで出した判定か。
   * **前提が変わったことに気づくため。**現在のバージョンと違えば古い判定。
   * 以前の判定は持っていないので null（＝いつのものか分からない）
   */
  versionId  String?  @map("version_id")

  product  Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  category RegulationCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  hits     ProductJudgementHit[]

  @@unique([productId, categoryId])
  // 一覧で「該当のものだけ」「要確認が残っているものだけ」を絞る
  @@index([categoryId, verdict])
  @@index([needsReview])
  @@map("product_judgements")
}

/**
 * 判定の根拠。**何がどれだけ入っていたから該当なのか。**
 * これが無いと「なぜ該当なのか」に答えられない。
 * 監査で問われたときに、この行を見せられることが値打ちになる。
 */
model ProductJudgementHit {
  id          String @id @default(cuid())
  judgementId String @map("judgement_id")

  /**
   * 当たった法文物質名。区分そのものでまとめて当たったときは空
   */
  statutorySubstanceId String?  @map("statutory_substance_id")
  /**
   * 合算した含有率。**まとめたときだけ入る。**
   * まとめないときは CAS ごとに別々に比べているので、合計には意味が無い。
   * そこに数字を入れると、足していないものを足したように読まれてしまう
   */
  total                Decimal? @db.Decimal(9, 6)
  /**
   * その値を作った CAS と、それぞれがいくら効いたか（[{ cas, pct }]）。
   * **「なぜその合計になったのか」に答えるために要る。**
   * 番号と割合を別々の配列で持つと、順番がずれたときに黙って食い違う
   */
  contributions        Json?

  judgement ProductJudgement @relation(fields: [judgementId], references: [id], onDelete: Cascade)

  @@index([judgementId])
  @@index([statutorySubstanceId])
  @@map("product_judgement_hits")
}

// ---------- 物質 ----------

model Substance {
  id             String @id @default(cuid())
  /**
   * 業務キー（ユーザーが付与）。原文を保持し、突合は正規化列で行う
   */
  code           String @db.VarChar(20)
  /**
   * 正規化コード（全角→半角・trim・大文字化）。
   * 論理削除するときは "<正規化コード>:<id>" に退避し、同じコードを再登録できるようにする。
   */
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  /**
   * CAS番号は任意（ポリマー・UVCB・企業秘密物質を登録できるようにするため）
   */
  casNumber           String? @map("cas_number") @db.VarChar(20)
  /**
   * 正規化CAS。法規制リンク・金属換算係数はこの値で突合する。一意にしない（別物質が同一CASを持てる）
   */
  casNormalized       String? @map("cas_normalized") @db.VarChar(20)
  /**
   * このCASを代表する物質か。
   * 同じCASの物質が複数あるとき、合算した行に出す名称をこの物質から取る。
   * 1つのCASにつき1件までで、制約は migration の部分ユニーク索引で持つ
   * （Prisma では条件付きの一意制約を書けないため）。
   */
  isCasRepresentative Boolean @default(false) @map("is_cas_representative")

  /**
   * 主名称。1物質1件なので子テーブルではなくこの行に持つ。
   * 別テーブルにすると一覧の並べ替え・フィルターができない（Prisma は 1対多 の項目で並べ替えできない）。
   */
  nameJa String  @map("name_ja") @db.VarChar(500)
  nameEn String? @map("name_en") @db.VarChar(500)

  /**
   * 当たっている規制区分のスコアの合計。**製品とは関係のない、物質固有の値**。
   * 現在のバージョンのCASリンクから計算して書き込む（`lib/score-store.ts`）。
   * 同じ区分に複数の法文物質名で当たっても1回だけ数える
   */
  score Decimal @default(0) @db.Decimal(12, 3)

  /**
   * スコアを言い換えた段階。対応表はシステム設定（`SubstanceRankBand`）。
   * どの段にも当てはまらなければ空
   */
  scoreRank String? @map("score_rank") @db.VarChar(50)

  /**
   * スコアを計算した時刻。いつ時点のものかを画面に出すために持つ
   */
  scoreAt DateTime? @map("score_at")

  status       SubstanceStatus @default(ACTIVE)
  /**
   * 公開の状態。公開済になるまで他の人には見せず、組成の候補にも出さない。
   * 有効／無効（status）とは別の軸。
   */
  publishState PublishState    @default(DRAFT) @map("publish_state")
  /**
   * 備考（日本語のみ）。検索対象に含める
   */
  note         String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  aliases          SubstanceAlias[]
  gazetteNumbers   SubstanceGazetteNumber[]
  properties       SubstanceProperty[]
  compositionLines CompositionLine[]

  @@index([casNormalized])
  @@index([status])
  @@index([nameJa])
  @@index([nameEn])
  @@index([score])
  @@index([scoreRank])
  @@map("substances")
}

/**
 * 別名（0件以上）。主名称は substances 側に持つ
 */
model SubstanceAlias {
  id           String  @id @default(cuid())
  substanceId  String  @map("substance_id")
  /**
   * 日本語と英語は件数が一致しないため、どちらか一方だけの行を許す（両方 null は不可・アプリ層で担保）
   */
  nameJa       String? @map("name_ja") @db.VarChar(500)
  nameEn       String? @map("name_en") @db.VarChar(500)
  displayOrder Int     @default(0) @map("display_order")

  substance Substance @relation(fields: [substanceId], references: [id], onDelete: Cascade)

  @@index([substanceId])
  @@index([nameJa])
  @@index([nameEn])
  @@map("substance_aliases")
}

model SubstanceGazetteNumber {
  id           String         @id @default(cuid())
  substanceId  String         @map("substance_id")
  lawKind      GazetteLawKind @map("law_kind")
  number       String         @db.VarChar(50)
  displayOrder Int            @default(0) @map("display_order")

  substance Substance @relation(fields: [substanceId], references: [id], onDelete: Cascade)

  @@unique([substanceId, lawKind, number])
  @@index([number])
  @@map("substance_gazette_numbers")
}

/**
 * 拡張属性の項目定義（システム管理者が作る）
 */
/**
 * 拡張属性の項目定義。物質と製品で1つの表を共有し、`target` でどちらのものかを分ける
 * （画面はグループ管理と同じく用途ごとに節を分ける）。
 * 値の表は FK を保ちたいので物質用・製品用に分ける。
 */
model PropertyDef {
  id           String           @id @default(cuid())
  target       PropertyTarget
  key          String           @db.VarChar(50)
  labelJa      String           @map("label_ja") @db.VarChar(100)
  labelEn      String?          @map("label_en") @db.VarChar(100)
  dataType     PropertyDataType @map("data_type")
  defaultUnit  String?          @map("default_unit") @db.VarChar(50)
  displayOrder Int              @default(0) @map("display_order")
  activeFlag   Boolean          @default(true) @map("active_flag")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  substanceValues SubstanceProperty[]
  productValues   ProductProperty[]

  /**
   * キーは用途ごとに一意。物質と製品で同じキーを使ってよい
   */
  @@unique([target, key])
  @@map("property_defs")
}

/**
 * 拡張属性の値（物質）。
 * 種類（数値/テキスト）と入っている列の整合は CHECK 制約でも担保する（migration SQL に手書き）。
 */
model SubstanceProperty {
  id            String   @id @default(cuid())
  substanceId   String   @map("substance_id")
  propertyDefId String   @map("property_def_id")
  valueText     String?  @map("value_text")
  valueNum      Decimal? @map("value_num") @db.Decimal(18, 6)
  unit          String?  @db.VarChar(50)

  substance Substance   @relation(fields: [substanceId], references: [id], onDelete: Cascade)
  def       PropertyDef @relation(fields: [propertyDefId], references: [id], onDelete: Cascade)

  @@unique([substanceId, propertyDefId])
  @@index([propertyDefId, valueNum])
  @@map("substance_properties")
}

// ---------- 製品 / 原材料 ----------

/**
 * 製品と原材料は同じもの。`usableAsMaterial` が立っているものだけ、
 * 他の製品の組成に部品として入れられる（これ以外に両者の違いは無い）。
 */
model Product {
  id             String @id @default(cuid())
  code           String @db.VarChar(20)
  /**
   * 論理削除するときは "<正規化コード>:<id>" に退避し、同じコードを再登録できるようにする
   */
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  nameJa String  @map("name_ja") @db.VarChar(500)
  nameEn String? @map("name_en") @db.VarChar(500)

  status       ProductStatus @default(ACTIVE)
  /**
   * 公開の状態。公開済になるまで他の人には見せず、組成の候補にも出さない。
   * 有効／無効（status）とは別の軸。
   */
  publishState PublishState  @default(DRAFT) @map("publish_state")
  /**
   * 備考（日本語のみ）。検索対象に含める
   */
  note         String?

  /**
   * 他製品の組成に部品として使えるか
   */
  usableAsMaterial Boolean @default(false) @map("usable_as_material")

  /**
   * 型式。システム設定に登録した選択肢から1つ選ぶ（値は文字列で持つ）
   */
  modelValue String? @map("model_value") @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  aliases    ProductAlias[]
  properties ProductProperty[]
  uses       ProductUse[]

  /**
   * この製品の組成（何が入っているか）
   */
  compositionLines CompositionLine[] @relation("ProductComposition")
  /**
   * この製品を原材料として使っている組成行（逆参照）
   */
  usedAsMaterialIn CompositionLine[] @relation("ProductAsMaterial")

  /**
   * 末端まで下ろして CAS でまとめた結果。組成が変わったら作り直す
   */
  expansion  ProductExpansion?
  /**
   * 区分ごとの判定結果。展開結果が変わったら作り直す
   */
  judgements ProductJudgement[]

  @@index([nameJa])
  @@index([nameEn])
  @@index([status])
  @@index([usableAsMaterial])
  @@index([publishState])
  @@index([modelValue])
  @@map("products")
}

/**
 * 別名（旧品番・社内の呼び方など）
 */
/**
 * 用途。1製品に複数持てる。
 * 選べる値はシステム設定に持ち、ここには選んだ文字列をそのまま残す
 * （設定から選択肢を消しても、過去の製品の記録は変わらないようにするため）。
 */
model ProductUse {
  id           String @id @default(cuid())
  productId    String @map("product_id")
  value        String @db.VarChar(100)
  displayOrder Int    @default(0) @map("display_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, value])
  @@index([value])
  @@map("product_uses")
}

model ProductAlias {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  /**
   * 日本語と英語は件数が一致しないため、どちらか一方だけの行を許す（両方 null は不可・アプリ層で担保）
   */
  nameJa       String? @map("name_ja") @db.VarChar(500)
  nameEn       String? @map("name_en") @db.VarChar(500)
  displayOrder Int     @default(0) @map("display_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([nameJa])
  @@index([nameEn])
  @@map("product_aliases")
}

/**
 * 拡張属性の値（製品）。項目定義は物質と共有する
 */
model ProductProperty {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  propertyDefId String   @map("property_def_id")
  valueText     String?  @map("value_text")
  valueNum      Decimal? @map("value_num") @db.Decimal(18, 6)
  unit          String?  @db.VarChar(50)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  def     PropertyDef @relation(fields: [propertyDefId], references: [id], onDelete: Cascade)

  @@unique([productId, propertyDefId])
  @@index([propertyDefId, valueNum])
  @@map("product_properties")
}

/**
 * 原組成の1行。製品に「何がどれだけ入っているか」を1段だけ持つ。
 * 構成要素は物質か子製品のどちらか一方（CHECK制約で担保）。
 * 多段の展開（親×子の掛け算で物質まで下ろす）は別テーブルに持つ（S11）。
 */
model CompositionLine {
  id              String  @id @default(cuid())
  parentProductId String  @map("parent_product_id")
  substanceId     String? @map("substance_id")
  childProductId  String? @map("child_product_id")

  /**
   * 重量含有率。**必ず入れる。**
   * かつて「残部」の行だけ空にして 100% との差から出していたが、その扱いはやめた
   */
  contentPct Decimal? @map("content_pct") @db.Decimal(9, 6)

  note         String?
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parentProduct Product    @relation("ProductComposition", fields: [parentProductId], references: [id], onDelete: Cascade)
  /**
   * 参照されているものは物理削除させない（論理削除の前にアプリ側で参照を確認する）
   */
  substance     Substance? @relation(fields: [substanceId], references: [id], onDelete: Restrict)
  childProduct  Product?   @relation("ProductAsMaterial", fields: [childProductId], references: [id], onDelete: Restrict)

  @@index([parentProductId])
  @@index([substanceId])
  @@index([childProductId])
  @@map("composition_lines")
}

// ---------- 金属換算係数 ----------

/**
 * 金属換算係数。
 * 「この CAS の物質には、その金属元素が重量で何パーセント含まれるか」を持つ。
 * 判定では 寄与 = 含有率 × ratio_pct ÷ 100 として使う。
 * 物質マスタとは物理FKで繋がない。CAS で引ければよく、
 * 物質として登録していない CAS の係数も先に持てるようにするため。
 */
model MetalConversionFactor {
  id            String  @id @default(cuid())
  /**
   * 原文。正規化した値は突合用
   */
  casNumber     String  @map("cas_number") @db.VarChar(20)
  casNormalized String  @map("cas_normalized") @db.VarChar(20)
  /**
   * 金属元素の記号（Pb, Cr, Cd など）
   */
  metalElement  String  @map("metal_element") @db.VarChar(4)
  /**
   * 重量パーセント。0 より大きく 100 以下（CHECK 制約は migration に手書き）
   */
  ratioPct      Decimal @map("ratio_pct") @db.Decimal(9, 6)

  /**
   * この値がどこから来たか。
   * **人が入れた値を、機械が上書きしないための目印**にする
   * （分子式から出せない値＝実測や、法令が定める換算率があるため）
   */
  note String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  @@unique([casNormalized, metalElement])
  @@index([casNormalized])
  @@map("metal_conversion_factors")
}

// ---------- お知らせ ----------

/**
 * ログイン後のホームに出すお知らせ。
 * 閲覧は全ログインユーザー。投稿は NEWS_POST、他人の分の編集・削除は NEWS_MANAGE。
 */
model News {
  id           String     @id @default(cuid())
  titleJa      String     @map("title_ja")
  bodyJa       String     @map("body_ja")
  /**
   * 英語は任意。未入力なら英語表示でも日本語を出す
   */
  titleEn      String?    @map("title_en")
  bodyEn       String?    @map("body_en")
  status       NewsStatus @default(DRAFT)
  /**
   * 重要なお知らせを一覧の先頭に固定する
   */
  pinned       Boolean    @default(false)
  /**
   * 掲載期間。null は「制限なし」
   */
  publishFrom  DateTime?  @map("publish_from")
  publishUntil DateTime?  @map("publish_until")
  authorId     String     @map("author_id")
  /**
   * ホームで見出しを分けるための分類。投稿時に投稿者のグループを写し取る。
   * 写すのは、投稿者が異動しても過去の投稿が別の見出しへ移らないようにするため。
   * null=分類なし（見出しの最後にまとめる）
   */
  groupId      String?    @map("group_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  author User   @relation(fields: [authorId], references: [id])
  group  Group? @relation(fields: [groupId], references: [id])

  @@index([status, pinned, publishFrom])
  @@index([authorId])
  @@index([groupId])
  @@map("news")
}

// ---------- 多言語 ----------
//
// 画面の文言は packages/shared/src/i18n の辞書ファイルで管理する（DBに持たない）。
// 訳の抜けをビルド時に検出できることと、表示のチラつきが無いことを優先した（docs/decisions/0002）。
// マスタの名称は各テーブルが日本語名・英語名の2列を持つ方式（物質・製品など）。

/**
 * 保存したフィルター。
 * 一覧のある画面すべてで共通。どの画面のものかは `tableKey`（DataTable の storageKey）で分ける。
 * 条件は URL のクエリ文字列と同じ形（@chem/shared の table.ts）で持つので、
 * 列構成が変わっても読めるものだけ効く（解釈できない条件は黙って無視される）。
 */
/**
 * 承認の履歴。物質と製品で共通に使うため、監査ログと同じく
 * entity + entityId で対象を指し、物理FKは張らない（スキーマ冒頭のルール）。
 */
model ApprovalEvent {
  id        String         @id @default(cuid())
  /**
   * "substance" / "product"
   */
  entity    String         @db.VarChar(20)
  entityId  String         @map("entity_id")
  action    ApprovalAction
  actorId   String?        @map("actor_id")
  /**
   * 却下の理由など。任意
   */
  comment   String?        @db.VarChar(500)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([entity, entityId, createdAt])
  @@map("approval_events")
}

model SavedFilter {
  id       String  @id @default(cuid())
  /**
   * どの一覧のものか（例: chem.table.products）
   */
  tableKey String  @map("table_key") @db.VarChar(100)
  title    String  @db.VarChar(100)
  /**
   * 並べ替え・フィルター・件数をまとめたクエリ文字列
   */
  query    String  @db.VarChar(2000)
  /**
   * true=全員が読める。false=作った本人だけ
   */
  shared   Boolean @default(false)

  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /**
   * 同じ人が同じ画面に同じ名前を2つ作れないようにする（上書き保存にする）
   */
  @@unique([tableKey, ownerId, title])
  @@index([tableKey, shared])
  @@map("saved_filters")
}

// ---------- フィードバック ----------

/**
 * 寄せられた声の種類
 */
enum FeedbackKind {
  BUG
  REQUEST
  QUESTION
  TODO
  IDEA
  OTHER
}

enum FeedbackPriority {
  HIGH
  MEDIUM
  LOW
}

/**
 * 対応の進み具合
 */
enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  DONE
}

/**
 * 使ってみて気づいたことの記録。開発中の窓口として使う。
 * 誰が書いたかは残すが、閲覧も更新もログインしている人なら誰でもできる。
 */
model Feedback {
  id       String           @id @default(cuid())
  title    String           @db.VarChar(200)
  body     String           @db.Text
  kind     FeedbackKind
  priority FeedbackPriority @default(MEDIUM)
  status   FeedbackStatus   @default(OPEN)

  /**
   * 返信。書いた内容は直さず、返信を重ねてやり取りする
   */
  comments FeedbackComment[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([kind])
  @@index([updatedAt])
  @@map("feedbacks")
}

/**
 * フィードバックへの返信。
 * **書いた内容は直さず、返信を重ねる。**元の書き込みにも、どの返信にも
 * （自分のものにも）返信できる。parentId が null なら元の書き込みへの返信。
 * 消すと deletedAt が入る。下に返信が残っていれば「削除されました」と場所だけ残す
 */
model FeedbackComment {
  id         String            @id @default(cuid())
  feedbackId String            @map("feedback_id")
  feedback   Feedback          @relation(fields: [feedbackId], references: [id])
  parentId   String?           @map("parent_id")
  parent     FeedbackComment?  @relation("FeedbackCommentReplies", fields: [parentId], references: [id])
  replies    FeedbackComment[] @relation("FeedbackCommentReplies")
  body       String            @db.Text

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([feedbackId])
  @@map("feedback_comments")
}

// ---------- 法規制 ----------
//
// 階層は 地域 → 法令 → 区分 → 分類 → 法文物質名 → CASリンク。
//
// 判定に使う値の置き場所を1か所に定めてある:
// - 閾値は**法文物質名**が持つ。区分の閾値はひな型で、作成時に複写するだけ（判定では読まない）
// - リンクは**法文物質名 ↔ CAS**。バージョンで管理するのはこのリンクだけで、
//   閾値や区分の増減はバージョンに含まれない（法改正は新しい区分などを別に登録して表す）
//
// 名称はどの段も 原文・原文の言語・日本語・英語 の4列で持つ。
// 一覧の並べ替え・絞り込みに使うため、子テーブルには出さない（CLAUDE.md §4）。

/**
 * 閾値の境目。
 * 下限では EXCLUSIVE=「超」/ INCLUSIVE=「以上」、
 * 上限では EXCLUSIVE=「未満」/ INCLUSIVE=「以下」を表す。
 */
/**
 * 判定のときに、含有率をどうまとめるか。
 * 法令の閾値は「その法文物質名として何％入っているか」に対して定められている。
 * CAS ごとに見ると、どれも閾値に届かないのに合計では超える、ということが起きる。
 * 例）鉛 0.06％ ＋ 酸化鉛 0.06％ → CASごとなら非該当、合計すれば 0.12％ で該当
 * これを取り違えると**該当を見落とす**ので、まとめかたを明示的に持つ。
 */
/**
 * 閾値が**何に対する濃度か**。
 * ほとんどの法令は製品（または成形品）全体に対する重量%で決まるが、
 * RoHS のように**均質材料あたり**で決まるものがある。
 * ねじのめっき、基板のはんだ、といった分けられない単位ごとに見るもので、
 * 製品全体で割ると必ず薄まり、**違反を見落とす**。
 * こちらの組成は製品全体でしか持っていないので、判定は出せても言い切れない。
 * `HOMOGENEOUS_MATERIAL` の区分は、当たっても当たらなくても必ず要確認にする。
 */
enum ThresholdBasis {
  /**
   * 製品全体に対する重量%
   */
  PRODUCT
  /**
   * 均質材料に対する重量%。こちらの組成では確かめきれない
   */
  HOMOGENEOUS_MATERIAL
}

enum AggregationMode {
  /**
   * まとめない。CAS ごとに閾値と比べる
   */
  NONE
  /**
   * そのまま足す
   */
  SUM
  /**
   * 金属換算係数を掛けてから足す（「鉛として」のような書きかたに対応する）
   */
  ELEMENT
}

/**
 * 判定の答え。**必ずどちらか**（決められないものは該当に倒す）
 */
enum JudgementVerdict {
  APPLICABLE
  NOT_APPLICABLE
}

/**
 * その答えを誰が出したか
 */
enum JudgementSource {
  /**
   * システムが計算した
   */
  SYSTEM
  /**
   * 人が上書きした
   */
  USER
}

enum ThresholdBound {
  EXCLUSIVE
  INCLUSIVE
}

/**
 * 言語。法規制の名称で「原文の言語」として選ぶ。
 * コードは ISO 639-1 を大文字にした2文字（JA, EN, ZH …）。
 * 打ち間違いで同じ言語が別扱いにならないよう、自由入力ではなくここから選ばせる。
 */
model Language {
  id     String @id @default(cuid())
  code   String @unique @db.VarChar(2)
  nameJa String @map("name_ja") @db.VarChar(100)
  nameEn String @map("name_en") @db.VarChar(100)

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  @@index([displayOrder])
  @@map("languages")
}

/**
 * 地域。アジア・欧州・北米・国際条約といった、国より大きいまとまりを表す。
 * 国（日本・アメリカ合衆国など）は地域ではないので、ここには入れない。
 */
model Region {
  id             String @id @default(cuid())
  code           String @db.VarChar(20)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  nameJa String  @map("name_ja") @db.VarChar(200)
  nameEn String? @map("name_en") @db.VarChar(200)

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  countries Country[]

  @@map("regions")
}

/**
 * 国。日本・アメリカ合衆国のほか、EU・EAEU のような国家連合や、
 * 国際条約のように国でないものも1件として置く（法令の持ち主になる単位）。
 * 米国の州は作らず、州法も「アメリカ合衆国」に入れる（法律名で見分けられるため）。
 */
model Country {
  id             String @id @default(cuid())
  code           String @db.VarChar(20)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  regionId String @map("region_id")

  nameJa String  @map("name_ja") @db.VarChar(200)
  nameEn String? @map("name_en") @db.VarChar(200)

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  region      Region      @relation(fields: [regionId], references: [id])
  laws        Law[]
  inventories Inventory[]

  @@index([regionId, displayOrder])
  @@map("countries")
}

/**
 * 法律の単位（化審法・毒劇法など）。持ち主は国。
 * 安衛法の下位規則（特化則・有機則）はここに並べず、区分として持つ
 */
model Law {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  countryId String @map("country_id")

  /**
   * 原文の名称（必須）。日本の法令は正式名称を入れ、通称は nameJa に入れる
   */
  nameOriginal String  @map("name_original")
  /**
   * 原文の言語。言語マスタのコード（JA / EN / ZH …）
   */
  nameLang     String  @map("name_lang") @db.VarChar(10)
  nameJa       String? @map("name_ja")
  nameEn       String? @map("name_en")

  displayOrder Int     @default(0) @map("display_order")
  note         String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  country    Country              @relation(fields: [countryId], references: [id])
  categories RegulationCategory[]

  @@index([countryId])
  @@index([displayOrder])
  @@map("laws")
}

/**
 * 区分。判定の骨組みで、SDSに書く単位でもある。
 * 閾値の4欄は**ひな型**。法文物質名を作るときに複写するだけで、判定では読まない。
 * 兼ね合いは「特定毒物に該当していれば毒物は出さない」という表示のルールに使う。
 * 上乗せの指定（特化則の特定第2類物質など）には効かせてはいけないので、
 * 全体の規則にはせず区分・分類ごとに持たせる。
 */
model RegulationCategory {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @map("code_normalized") @db.VarChar(64)

  lawId String @map("law_id")

  nameOriginal String  @map("name_original")
  nameLang     String  @map("name_lang") @db.VarChar(10)
  nameJa       String? @map("name_ja")
  nameEn       String? @map("name_en")

  /**
   * 改正で番号に割込みが起きるため、並べ替えは番号ではなくこの値で行う
   */
  displayOrder Int @default(0) @map("display_order")

  /**
   * 既定の閾値（ひな型・4欄とも必須）。初期値は 0 < x <= 100
   */
  thresholdLower Decimal        @map("threshold_lower") @db.Decimal(9, 6)
  lowerBound     ThresholdBound @map("lower_bound")
  thresholdUpper Decimal        @map("threshold_upper") @db.Decimal(9, 6)
  upperBound     ThresholdBound @map("upper_bound")

  /**
   * この区分に該当するものを、区分の単位でまとめるか。
   * **これが NONE 以外なら、配下の法文物質名のまとめかたは見ない。**
   * 区分でまとめるときは、その区分に紐づく CAS を重複なく集めて一度だけ足す。
   * 法文物質名ごとの合計を足し上げると、同じ CAS が2つの法文物質名に
   * 紐づいていたときに二重に数えてしまう。
   */
  aggregation AggregationMode @default(NONE)
  /**
   * 元素換算でまとめるときの元素記号（Pb, Cr, Cd …）。ELEMENT のときだけ使う
   */
  metalEtc    String?         @map("metal_etc") @db.VarChar(4)

  /**
   * 閾値が何に対する濃度か。既定は製品全体。
   * 均質材料あたりの区分は、判定を出しても必ず要確認にする
   */
  thresholdBasis ThresholdBasis @default(PRODUCT) @map("threshold_basis")

  /**
   * 判定に使うか。
   * **候補の一覧を「持つだけ」にできるようにする。**
   * 中環審答申の有害大気汚染物質のように、
   * 含有率で該非が決まるのではなく「該当する可能性がある物質」を並べたものがある。
   * 判定に出すと、ほとんどの製品で該当が並び、本当に効く規制が埋もれる。
   * 物質の画面では区分として見えるが、製品の判定には出さない、という状態を作る
   */
  judged Boolean @default(true)

  /**
   * 兼ね合い。同じグループの中で rank の小さい方だけを出す。
   * **物質のランク（`Substance.scoreRank`）とは別のもの**
   */
  interactionGroup String? @map("interaction_group") @db.VarChar(50)
  rank             Int?

  /**
   * 人が決める評価点。**物質のスコアは、当たっている区分のこの値の合計**。
   * 入れられる範囲はシステム設定で決める（既定 0〜100）。
   * 判定に使わない区分（`judged = false`）は合計に入れない
   */
  score Decimal @default(0) @db.Decimal(9, 3)

  note String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  law        Law                @relation(fields: [lawId], references: [id])
  classes    RegulationClass[]
  judgements ProductJudgement[]

  @@unique([lawId, codeNormalized])
  @@index([lawId, displayOrder])
  @@index([interactionGroup, rank])
  @@map("regulation_categories")
}

/**
 * 分類。特化則の第1類・第2類のように、区分をさらに分けるときに使う。
 * **分けない区分にも必ず1件置く**（原文名を空にすると画面に出さない）。
 * 中の形を1通りに保つための約束で、法文物質名の親は常に分類になる。
 * 後から分けたくなったら、その1件に名前を付けて2件目を足せばよく、既存のぶら下がりは動かない。
 */
model RegulationClass {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @map("code_normalized") @db.VarChar(64)

  categoryId String @map("category_id")

  /**
   * 空なら画面に出さない（分けない区分の受け皿）
   */
  nameOriginal String? @map("name_original")
  nameLang     String? @map("name_lang") @db.VarChar(10)
  nameJa       String? @map("name_ja")
  nameEn       String? @map("name_en")

  displayOrder Int @default(0) @map("display_order")

  interactionGroup String? @map("interaction_group") @db.VarChar(50)
  rank             Int?

  note String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  category            RegulationCategory   @relation(fields: [categoryId], references: [id])
  statutorySubstances StatutorySubstance[]

  @@unique([categoryId, codeNormalized])
  @@index([categoryId, displayOrder])
  @@index([interactionGroup, rank])
  @@map("regulation_classes")
}

/**
 * 法文物質名。法令の一覧に載っている物質名で、**判定はこの行の閾値だけを読む**。
 * 「〜及びその塩」「〜化合物」のような群も1件として持ち、CASリンクを複数張る。
 */
model StatutorySubstance {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @map("code_normalized") @db.VarChar(64)

  classId String @map("class_id")

  /**
   * 法令が付けている番号（政令番号・通し番号・官報公示整理番号など）。
   * 改正で「2の2」のような枝番になるため文字列で持ち、並べ替えには使わない
   */
  officialNumber String? @map("official_number") @db.VarChar(50)

  nameOriginal String  @map("name_original")
  nameLang     String  @map("name_lang") @db.VarChar(10)
  nameJa       String? @map("name_ja")
  nameEn       String? @map("name_en")

  displayOrder Int @default(0) @map("display_order")

  /**
   * この法文物質名に該当する CAS を、まとめて数えるか。
   * 法令の閾値は「この法文物質名として何％入っているか」に対して定められている。
   * 「鉛及びその化合物」のような書きかたでは、配下の CAS を合計しないと
   * **該当を見落とす**。
   * ただし**区分の側でまとめると決めているときは、ここは見ない**（区分が優先）。
   */
  aggregation AggregationMode @default(NONE)
  /**
   * 元素換算でまとめるときの元素記号（Pb, Cr, Cd …）。ELEMENT のときだけ使う
   */
  metalEtc    String?         @map("metal_etc") @db.VarChar(4)

  /**
   * 判定に使う閾値。4欄とも必須。作成時に区分の既定を複写する
   */
  thresholdLower Decimal        @map("threshold_lower") @db.Decimal(9, 6)
  lowerBound     ThresholdBound @map("lower_bound")
  thresholdUpper Decimal        @map("threshold_upper") @db.Decimal(9, 6)
  upperBound     ThresholdBound @map("upper_bound")

  /**
   * 参考情報。**判定には使わない**（どの一覧を使うかはバージョンと、登録してある区分で決まる）
   */
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /**
   * **適用条件。**濃度のほかに条件が付く法文物質名に、その条件を書く。
   * 用途・剤型・製品の種類で決まるもの（RoHS 附属書III の適用除外、
   * 第一種特定の使用用途など）は、こちらの持っている情報だけでは判定できない。
   * **ここに何か入っていれば、当たったときに必ず「要確認」を出す。**
   * 条件は法律の側で決まっているので、**データソースやバージョンでは変わらない。**
   * 備考（`note`）とは分ける。備考には取り込み元の付随情報（EC番号・分類など）が
   * 入っており、それで要確認を出すと、ほぼ全件が要確認になる
   */
  applicableCondition String? @map("applicable_condition")

  /**
   * 参考の覚え書き。**判定には使わない**
   */
  note String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  regulationClass RegulationClass    @relation(fields: [classId], references: [id])
  links           StatutoryCasLink[]

  linkDiffs StatutoryCasLinkDiff[]

  @@unique([classId, codeNormalized])
  @@index([classId, displayOrder])
  @@map("statutory_substances")
}

/**
 * バージョン。管理する対象は **CASリンクだけ**。
 * 「現在のバージョン」を明示的に指定する（作っただけでは切り替わらない）。
 * 制約は migration の部分ユニーク索引で持つ（Prisma では条件付きの一意制約を書けない）
 */
/**
 * バージョン。コードだけを登録する（中身はデータソースの側に付く）
 */
model LinkSetVersion {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  nameJa String? @map("name_ja") @db.VarChar(200)
  nameEn String? @map("name_en") @db.VarChar(200)

  /**
   * 基準日。そのデータが何時点のものか。**新旧はコードではなくこれで決める**
   * （コードは利用者が自由に付ける名前で、文字順が時系列と合うとは限らない）。
   * 一覧の並び・現在の自動判定・前のバージョン・差分の相手は、すべてこの降順
   * （同じ日なら登録した順）
   */
  asOf DateTime @map("as_of") @db.Date

  /**
   * 判定に使うバージョン。システム全体で1件だけ立てられる。
   * バージョンが1件でもあれば、必ずどれかが立つ
   */
  isCurrent Boolean @default(false) @map("is_current")

  /**
   * 利用者が明示的に選んだものか。
   * 立っていなければ自動で選ばれたもので、新しいバージョンが増えるとそちらへ移る
   */
  currentPinned Boolean   @default(false) @map("current_pinned")
  loadedAt      DateTime? @map("loaded_at")
  note          String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  sources       LinkVersionSource[]
  links         StatutoryCasLink[]
  inventoryRows InventoryRow[]

  linkDiffs           StatutoryCasLinkDiff[]    @relation("LinkDiffVersion")
  linkDiffsAgainst    StatutoryCasLinkDiff[]    @relation("LinkDiffAgainst")
  linkDiffRuns        StatutoryCasLinkDiffRun[] @relation("LinkDiffRunVersion")
  linkDiffRunsAgainst StatutoryCasLinkDiffRun[] @relation("LinkDiffRunAgainst")

  @@index([asOf])
  @@map("link_set_versions")
}

/**
 * データソース（USER / LOLI / CHRIP など）。
 * 優先度はここには持たない。バージョンごとに決まるため LinkVersionSource が持つ
 */
/**
 * データソース種別（LOLI・CHRIP・自社データなど）。
 * コードと説明だけ。どのバージョンでどの順に読むかはデータソースの側で決める
 */
model Source {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  /**
   * どんなデータで、どこまで載っているか
   */
  note String?

  /**
   * 画面で使う色。`#rrggbb`。
   * **データソースごとに1つ。**どのバージョンでも同じ色で出す。
   * 色が違えば別の出どころだと一目で分かるようにするためのもので、
   * バージョンごとに変えると、その手がかりが消える。
   * 決めていなければ空。画面は色を使わない見せかたに落とす
   */
  color String? @db.VarChar(7)

  /**
   * 画面の印に出す文字。決めていなければコードの頭文字を使う。
   * **頭文字はぶつかる。**`CHRIP` と `CFR` はどちらも `C` になり、
   * 印だけでは見分けられない。1文字とは限らないので、短い語も入れられる
   */
  mark String? @db.VarChar(8)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  versions      LinkVersionSource[]
  links         StatutoryCasLink[]
  inventoryRows InventoryRow[]

  @@map("sources")
}

/**
 * バージョンごとのデータソースと優先度。
 * 判定は優先度の高いものから順に当て、**最初に見つかったリンクで確定する**
 */
model LinkVersionSource {
  id        String @id @default(cuid())
  versionId String @map("version_id")
  sourceId  String @map("source_id")
  /**
   * 小さいほど優先。通常は自社で登録したもの（USER）を 1 にする。
   * 登録するときは末尾に付け、あとから上下に動かして決める
   */
  priority  Int

  /**
   * どのファイルを入れたか、どこまで載っているかを書く
   */
  note String?

  /**
   * 取り込んだ日時。ファイルは種別ごとに届くので、バージョン単位ではなくここに持つ
   */
  loadedAt DateTime? @map("loaded_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  version LinkSetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  source  Source         @relation(fields: [sourceId], references: [id])

  @@unique([versionId, sourceId])
  @@unique([versionId, priority])
  @@map("link_version_sources")
}

/**
 * 法文物質名と CAS番号 のつながり。バージョンで管理するのはこの表だけ。
 * CAS番号を持たない物質（ポリマー・UVCB・企業秘密物質）は、
 * 物質側に入れた独自コードで結ぶ。突合はどちらも cas_normalized で行う。
 */
model StatutoryCasLink {
  id                   String @id @default(cuid())
  versionId            String @map("version_id")
  statutorySubstanceId String @map("statutory_substance_id")
  sourceId             String @map("source_id")

  /**
   * 原文。突合は正規化列で行う
   */
  casNumber     String @map("cas_number") @db.VarChar(20)
  casNormalized String @map("cas_normalized") @db.VarChar(20)

  /**
   * 立てると**非該当で確定する**。
   * 優先度の高いデータソースが、下位のソースの内容を打ち消すために使う
   */
  excluded Boolean @default(false)

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  version            LinkSetVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  statutorySubstance StatutorySubstance    @relation(fields: [statutorySubstanceId], references: [id])
  source             Source                @relation(fields: [sourceId], references: [id])
  /**
   * 出どころがこのCASについて書いている文章。無いリンクのほうが多いので別テーブル
   */
  data               StatutoryCasLinkData?

  diffAsCurrent  StatutoryCasLinkDiff[] @relation("LinkDiffCurrent")
  diffAsPrevious StatutoryCasLinkDiff[] @relation("LinkDiffPrevious")

  @@unique([versionId, statutorySubstanceId, casNormalized, sourceId])
  /**
   * 判定はここを引く。製品に入っているCASの集合から一気に絞り込む
   */
  @@index([versionId, casNormalized])
  @@index([statutorySubstanceId])
  /**
   * 外部データベースの画面で、バージョン × データソースの全リンクを一覧にする
   */
  @@index([versionId, sourceId])
  @@map("statutory_cas_links")
}

/**
 * リンク1本に付く、出どころの文章。
 * LOLI なら `ListData.Data`（「>= 0.3 wt% cut-off value (Attached table, 2-1437, [Toluene])」の類）。
 * **どのデータソースでも入れられる**が、無いリンクのほうが多いので別テーブルに置き、
 * 無ければ行を作らない。原文は出どころの言語のまま（LOLI は英語）。
 * 日本語訳は出どころが持っていれば入れる（LOLI はコンパクト版の `ListData_Translation`）
 */
model StatutoryCasLinkData {
  linkId String  @id @map("link_id")
  /**
   * 原文。出どころの言語のまま
   */
  text   String
  /**
   * 日本語訳。出どころに無ければ null
   */
  textJa String? @map("text_ja")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  link StatutoryCasLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("statutory_cas_link_data")
}

/// バージョン間の対象CASの差分の種類
enum LinkDiffKind {
  ADDED
  REMOVED
  CHANGED
}

/**
 * 2つのバージョンの対象CASの差分（同じデータソースどうし）。
 * 外部データベースの「対象CAS」の表で「差分」を押したときに読む。
 * 突き合わせは「法文物質名 × CAS」。同じものは残さず、増えた・消えた・変わった だけを置く。
 * リンクが変わっていなければ前回の結果を使う（run の computedAt で見る）
 */
model StatutoryCasLinkDiff {
  id                   String       @id @default(cuid())
  versionId            String       @map("version_id")
  againstId            String       @map("against_id")
  sourceId             String       @map("source_id")
  statutorySubstanceId String       @map("statutory_substance_id")
  casNormalized        String       @map("cas_normalized") @db.VarChar(20)
  kind                 LinkDiffKind
  /**
   * 今の版の行。消えたものは無い
   */
  currentLinkId        String?      @map("current_link_id")
  /**
   * 比べた版の行。増えたものは無い
   */
  previousLinkId       String?      @map("previous_link_id")
  computedAt           DateTime     @default(now()) @map("computed_at")

  version            LinkSetVersion     @relation("LinkDiffVersion", fields: [versionId], references: [id], onDelete: Cascade)
  against            LinkSetVersion     @relation("LinkDiffAgainst", fields: [againstId], references: [id], onDelete: Cascade)
  statutorySubstance StatutorySubstance @relation(fields: [statutorySubstanceId], references: [id], onDelete: Cascade)
  currentLink        StatutoryCasLink?  @relation("LinkDiffCurrent", fields: [currentLinkId], references: [id], onDelete: Cascade)
  previousLink       StatutoryCasLink?  @relation("LinkDiffPrevious", fields: [previousLinkId], references: [id], onDelete: Cascade)

  @@unique([versionId, againstId, sourceId, statutorySubstanceId, casNormalized])
  @@index([versionId, againstId, sourceId, kind])
  @@map("statutory_cas_link_diffs")
}

/**
 * 差分を作った記録。件数の要約と、いつ作ったか（古くなったかを見る）
 */
model StatutoryCasLinkDiffRun {
  id         String   @id @default(cuid())
  versionId  String   @map("version_id")
  againstId  String   @map("against_id")
  sourceId   String   @map("source_id")
  computedAt DateTime @default(now()) @map("computed_at")
  added      Int
  removed    Int
  changed    Int

  version LinkSetVersion @relation("LinkDiffRunVersion", fields: [versionId], references: [id], onDelete: Cascade)
  against LinkSetVersion @relation("LinkDiffRunAgainst", fields: [againstId], references: [id], onDelete: Cascade)

  @@unique([versionId, againstId, sourceId])
  @@map("statutory_cas_link_diff_runs")
}

/**
 * 元素。法文物質名の「金属等」で選ぶ。
 * キーは元素記号。換算係数の表が記号で持っており、そのまま突き合わせられるため。
 * 番号は並べ替えのために持つ。
 * シアン（CN）のように元素でないものも入るので、その場合は900番台を振る。
 */
model Element {
  symbol       String @id @db.VarChar(4)
  atomicNumber Int    @unique @map("atomic_number")
  nameJa       String @map("name_ja") @db.VarChar(100)
  nameEn       String @map("name_en") @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  @@map("elements")
}

/**
 * 各国のインベントリ（既存化学物質の目録）。
 * **規制区分としては持たない。**
 * 判定は登録されている区分をすべて見に行くので、インベントリを区分として入れると
 * どの製品もすべてのインベントリに「該当」してしまう。
 * インベントリは「載っているか」と「そのインベントリでの番号」を持つだけのもので、
 * 含有率と閾値で当たりを決める規制とは性質が違う。
 */
model Inventory {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  countryId String @map("country_id")

  nameOriginal String  @map("name_original")
  nameLang     String  @map("name_lang") @db.VarChar(10)
  nameJa       String? @map("name_ja")
  nameEn       String? @map("name_en")

  /**
   * 取り込み元の LOLI の一覧番号。取り込み直すときに使う
   */
  sourceListId Int? @map("source_list_id")
  displayOrder Int  @default(0) @map("display_order")

  /**
   * 物質の画面に出すときの見出し
   */
  numberLabel String? @map("number_label")
  /**
   * 出す順。法令の並びとは別に決める
   */
  numberOrder Int     @default(0) @map("number_order")
  /**
   * このインベントリの番号を、物質の画面に出すか。
   * **呼び名とは別に持つ。**出すのをやめても呼び名は残しておきたいため
   * （消してしまうと、また出したくなったときに付け直すことになる）。
   * 呼び名が空のときは、立っていても出せない
   */
  numberShown Boolean @default(false) @map("number_shown")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  country Country        @relation(fields: [countryId], references: [id])
  rows    InventoryRow[]

  @@index([countryId, displayOrder])
  @@map("inventories")
}

/**
 * インベントリの1行。**加工済みの値を持つ。**
 * インベントリは他の法規制とは別に取り込むもので、
 * 番号の取り出し（正規表現）は取り込みスクリプトが受け持つ。
 * ここに入るのは仕上がった値——番号か、「該当」のような文字。
 * 1つの物質に複数の番号が付くインベントリ（EINECS・KECI）では、番号の数だけ行ができる。
 * **バージョンとデータソースを持つ。**持ちかたは `StatutoryCasLink` と同じ。
 * 列の中身が違うだけで、仕組みは他の法規制データと揃えてある。
 * バージョン         … インベントリは改訂される。「いつ時点のもので見たか」が残らないと
 * 判定の跡をたどれない
 * データソース … 同じインベントリを別々のところから取れる。どちらを採るかは
 * バージョンごとの優先度（`LinkVersionSource`）で決める
 * インベントリそのもの（`Inventory`）はバージョンを持たない——改訂されるのは中身であって、
 * 「ENCS」というインベントリの存在ではないため。
 */
model InventoryRow {
  id          String @id @default(cuid())
  versionId   String @map("version_id")
  sourceId    String @map("source_id")
  inventoryId String @map("inventory_id")

  casNumber     String @map("cas_number") @db.VarChar(20)
  casNormalized String @map("cas_normalized") @db.VarChar(20)
  /**
   * 画面にそのまま出す値。番号（`(5)-3714`）か、番号を持たないインベントリの「該当」
   */
  value         String

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  version   LinkSetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  source    Source         @relation(fields: [sourceId], references: [id])
  inventory Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([versionId, sourceId, inventoryId, casNormalized, value])
  // 物質の画面は「現在のバージョン × CAS」で引く
  @@index([versionId, casNormalized])
  @@index([inventoryId])
  @@map("inventory_rows")
}

/**
 * テンプレートが1件受け取るもの。
 * 製品なら組成と判定、物質なら該当法規とインベントリ番号が引ける
 */
/**
 * 様式の作りかた。
 * - `BLOCK` … 画面でブロックを積んだもの。中身は `content`
 * - `XLSX` / `DOCX` … Excel・Word のファイルを預かり、差込札に値を埋めて返す。
 * **罫線・セル結合・ヘッダー・ロゴがそのまま使えるので、
 * 取引先から来た調査票の形をそのまま出せる**
 */
enum DocumentTemplateKind {
  BLOCK
  XLSX
  DOCX
}

enum DocumentTarget {
  PRODUCT
  SUBSTANCE
}

/**
 * ドキュメント生成のテンプレート。
 * **中身はシステムの中で作る。**Wordファイルを預からないので、
 * 保存の置き場が要らず、差込項目の打ち間違いも起きない
 * （項目は一覧から選ぶ。`@chem/shared` の `document.ts`）。
 * **出す形はここに書かない。**中身は「何を、どの順で出すか」だけで、
 * HTML にするか .docx にするかは出す側が決める。
 * 書いてしまうと、出し先が増えるたびにテンプレートを作り直すことになる。
 */
model DocumentTemplate {
  id             String @id @default(cuid())
  code           String @db.VarChar(50)
  codeNormalized String @unique @map("code_normalized") @db.VarChar(64)

  nameJa String  @map("name_ja")
  nameEn String? @map("name_en")

  target DocumentTarget

  kind DocumentTemplateKind @default(BLOCK)

  /**
   * ブロックの並び。`@chem/shared` の `DocumentContent`。
   * **形が変わったときのために、読めるかを毎回確かめてから使う**。
   * `kind` が `BLOCK` のときだけ使う
   */
  content Json

  /**
   * 預かった Excel・Word のファイルそのもの。`kind` が `XLSX` / `DOCX` のとき。
   * **DBに置く。**添付は1様式に1つ、数百KBなので、
   * 置き場所を別に用意するほどではない（アバターと同じ考え）
   */
  fileData      Bytes?    @map("file_data")
  fileName      String?   @map("file_name") @db.VarChar(255)
  fileUpdatedAt DateTime? @map("file_updated_at")

  /**
   * 出す言語。テンプレートを言語ごとに作って多言語に対応する
   * （文面そのものを翻訳する仕組みは持たない）
   */
  locale String @default("JA") @db.VarChar(10)

  /**
   * 通番。**作った順に自動で振る。**
   * 並べ替えのために数字を打たせない（打ち直しの手間に見合わない）。
   * 消してもここは飛ぶだけで、詰め直さない（記録から番号をたどれるようにするため）
   */
  seq Int @unique @default(autoincrement())

  /**
   * 宛先を差し込む様式か。
   * **印が付いている様式だけ、作るときに宛先を選ばせる。**
   * どの様式でも毎回聞くと、宛名の要らない社内文書でも手間が増える
   */
  usesRecipient Boolean @default(false) @map("uses_recipient")

  active Boolean @default(true)
  note   String?

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  documents GeneratedDocument[]

  @@index([target, seq])
  @@map("document_templates")
}

/**
 * 作った記録。
 * **中身は残さない。**残すと、あとで権限が変わった人が
 * 古いファイルを取れてしまう。誰がいつ何に対して作ったかだけを持ち、
 * 同じものが要るときはもう一度作る
 */
model GeneratedDocument {
  id         String @id @default(cuid())
  templateId String @map("template_id")

  /**
   * 製品ID・物質IDなど。表をまたぐので関連は張らない
   */
  targetRef  String @map("target_ref")
  /**
   * そのときのコード。対象が消えても記録が読めるように控える
   */
  targetCode String @map("target_code") @db.VarChar(50)

  /**
   * 出したときの紙面そのもの（差込を済ませた文字と表の並び）。
   * **PDF や HTML ではなく、組み立て終わったデータで持つ。**
   * 数KBで済むうえ、あとから .docx のような出し先が増えても同じ内容から出せる。
   * テンプレートを書き換えても、発行済みのものは変わらない。
   */
  content Json

  /**
   * 組成が入っているか。
   * **開くときに組成の権限を確かめるための印。**
   * 作った当時は見られた人でも、あとで権限を外されることがある。
   * 紙面を保存する以上、開くたびに確かめないと、外した意味がなくなる
   */
  hasComposition Boolean @default(false) @map("has_composition")

  /**
   * 作ったときの条件（バージョンなど）。何を見て出したのかを残す
   */
  params Json?

  generatedBy String?  @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  template DocumentTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId, generatedAt])
  @@index([targetRef])
  @@map("generated_documents")
}
