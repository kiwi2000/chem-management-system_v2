# 本番環境変数のテンプレート。VPS上で .env.prod にコピーして編集する。
# .env.prod はコミット禁止（.gitignore 済み・CLAUDE.md §8）

# 業務DBのパスワード（必ず長いランダム文字列に変更。例: openssl rand -base64 24）
DB_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM

# 公開ポート（通常は変更不要。ローカル検証時のみ 8080/8443 などに変更）
HTTP_PORT=80
HTTPS_PORT=443

# 認証は自前実装のため、外部サービスの設定は不要（完全閉域運用）。
# 初回のパスワード発行はサーバ上で:
#   docker compose -f compose.prod.yml --env-file .env.prod exec app \
#     npx tsx scripts/set-password.ts <メールアドレス> <パスワード>

# 決まった場所からだけ入れるようにする。Railway の Variables で設定する。
# **空にすれば制限が外れる。**締め出されたときはここを空にして戻す。
# 例: ALLOWED_IPS="203.0.113.9, 198.51.100.0/24"
ALLOWED_IPS=""
# まず monitor で様子を見て、記録に問題が無ければ enforce に切り替える
IP_FILTER_MODE="monitor"
