# Windows Server 直置き構成（Docker なし）用の Caddy 設定。
# Docker 構成は Caddyfile（app:3001）。こちらはアプリが同じ機械の 127.0.0.1:3001 で動く。
#
#   nssm install chem-caddy C:\chem\caddy\caddy.exe "run --config C:\chem\deploy\Caddyfile.windows"
#
# 証明書は Caddy 内部CAが発行する（初回はブラウザに警告が出る）。警告を消すには
# %ProgramData%\caddy\pki\authorities\local\root.crt（サービス実行時）を
# 各PCの「信頼されたルート証明機関」に登録する。
{
	on_demand_tls {
		ask http://127.0.0.1:3001/api/health
	}
}

:443 {
	tls internal {
		on_demand
	}
	reverse_proxy 127.0.0.1:3001
}

:80 {
	redir https://{host}{uri} permanent
}
