// 国連 GHS 改訂 9 版（抜粋。急性毒性（経口）と皮膚腐食性／刺激性）。S27 §3-1 の見本
ruleset "UN-Rev9" version 1 {
  meta {
    title "国連 GHS 改訂 9 版（2021）"
    revision "GHS Rev.9"
    note "任されている所は options に選択点として置く。国のレイヤーで choose する"
  }

  classes {
    class acute.oral "急性毒性（経口）" categories [1, 2, 3, 4, 5] unit mg/kg
    class acute.dermal "急性毒性（経皮）" categories [1, 2, 3, 4, 5] unit mg/kg
    class skin "皮膚腐食性／刺激性" categories [1, 1A, 1B, 1C, 2, 3]
      subcategories 1 -> [1A, 1B, 1C]
  }

  options {
    option acute.category5 "急性毒性 区分 5 を採るか" values [adopt, exclude] safest adopt
      source "1.1.3.1.5.4, 3.1.2.5"
    option skin.category3 "皮膚刺激性 区分 3 を採るか" values [adopt, exclude] safest adopt
      source "3.2.2 (c)"
    option skin.subdivision "皮膚腐食性 1A/1B/1C を分けるか" values [split, merge] safest split
      source "3.2.2 (a)"
    option acute.unknown_statement "未知成分の文をどこに書くか" values [label, sds, both, manufacturer] safest both
      source "3.1.3.6.2.2"
    option acute.unknown_policy "未知成分が多いときの扱い" values [correction, unclassifiable_over(0.1 %)] safest correction
      source "3.1.3.6.2.3（補正の式）。unclassifiable_over は Gmiccs の作り（原文に無い）"
  }

  rules {
    // 急性毒性（経口）: 混合物の ATE を加算式で求め、区分に当てる
    rule acute.oral {
      consider ingredients where conc >= 1 % or flagged(relevant)
      ignore ingredients where flagged(no_acute_toxicity)
      bands { 1: ate <= 5, 2: ate <= 50, 3: ate <= 300, 4: ate <= 2000, 5: ate <= 5000 }
      conversion ate { 1: 0.5, 2: 5, 3: 100, 4: 500, 5: 2500 }
      additivity {
        ate_of = coalesce(ate(oral), convert(category(acute.oral)))
        unknown_part = ingredients where unknown(acute.oral)
        known_part = ingredients where not unknown(acute.oral)
        // 1 % 未満の成分も含めた未知の合計（Gmiccs 式の 0.1 % の判断に使う）
        unknown_total = all_ingredients where unknown(acute.oral)
        if sum(conc of unknown_part) > 10 % then
          atemix = (100 % - sum(conc of unknown_part)) / sum(conc / ate_of of known_part)
        else
          atemix = 100 % / sum(conc / ate_of of known_part)
      }
      if option(acute.unknown_policy) == unclassifiable_over and sum(conc of unknown_total) >= option_arg(acute.unknown_policy) then
        unclassifiable
      if sum(conc of unknown_part) >= 1 % then
        note "混合物の {sum(conc of unknown_part)} は急性毒性（経口）が未知の成分からなる" place option(acute.unknown_statement)
      classify by bands(atemix)
    }

    // 皮膚腐食性／刺激性: 加成方式。pH の決め打ちが先。加成方式が使えない成分があれば別の表
    rule skin {
      consider ingredients where conc >= 1 % or flagged(relevant)
      precondition {
        if has_value(product.ph) and (product.ph <= 2 or product.ph >= 11.5) then {
          classify skin as 1 because "pH が 2 以下または 11.5 以上（3.2.3.1.3）"
          needs_judgement "pH による決め打ち。酸・アルカリの予備量のデータがあれば見直す"
        }
      }
      nonadditive ingredients where flagged(non_additive)
      if any(non_additive) then {
        if sum(conc of non_additive where category(skin) in [1, 1A, 1B, 1C]) >= 1 % then
          classify skin as 1
        else if sum(conc of non_additive where category(skin) == 2) >= 3 % then
          classify skin as 2
        else
          not_classified
      } else weighted_sum {
        c1 = sum(conc of ingredients where category(skin) in [1, 1A, 1B, 1C])
        c1a = sum(conc of ingredients where category(skin) == 1A)
        c1b = sum(conc of ingredients where category(skin) == 1B)
        c1c = sum(conc of ingredients where category(skin) == 1C)
        c2 = sum(conc of ingredients where category(skin) == 2)
        c3 = sum(conc of ingredients where category(skin) == 3)
        if c1 >= 5 % then
          // 細区分は、全成分に細区分のデータがあるときだけ付ける（3.2.3.3.4.1）。無ければ区分 1
          classify skin as (if option(skin.subdivision) == split then (if c1a >= 5 % then 1A else if c1a + c1b >= 5 % then 1B else if c1a + c1b + c1c >= 5 % then 1C else 1) else 1)
        else if c1 >= 1 % or 10 * c1 + c2 >= 10 % then
          classify skin as 2
        else if 10 * c1 + c2 + c3 >= 10 % or c3 >= 10 % then
          classify skin as 3
        else
          not_classified
      }
    }
  }

  labels {
    option label.h_omission "H 文の省略の規則を義務にするか" values [required, manufacturer] safest required
      source "1.4.10.5.3.3"
    signal_word_precedence { danger over warning }
    h_precedence { H410 suppresses H400; H411 suppresses H401; H412 suppresses H402; H314 suppresses H318 }
  }

  tests {
    test "皮膚 区分 1 の成分 6 %" {
      mixture { "A" 6 % skin 1 }
      expect { skin 1 }
    }
    test "皮膚 加成方式 10×区分1 + 区分2（1 % 未満でも relevant の印があれば数える）" {
      mixture { "A" 0.5 % skin 1 flag relevant; "B" 6 % skin 2 }
      expect { skin 2 }
    }
    test "皮膚 1A が 5 % 以上なら 1A（UN は細区分を分ける）" {
      mixture { "A" 6 % skin 1A }
      expect { skin 1A }
    }
    test "急性経口 全成分が区分 3 の変換値" {
      mixture { "A" 50 % acute.oral 3; "B" 50 % acute.oral 3 }
      expect { acute.oral 3 }
    }
    test "急性経口 区分 5 の範囲は UN では区分 5" {
      mixture { "A" 100 % ate.oral = 3000 mg/kg }
      expect { acute.oral 5 }
    }
    test "pH 1.5 なら皮膚 区分 1" {
      mixture { "A" 100 % skin 2 }
      props { ph 1.5 }
      expect { skin 1 }
    }
  }
}
