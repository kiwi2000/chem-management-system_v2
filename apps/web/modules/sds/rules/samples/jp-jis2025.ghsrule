// 日本 JIS Z 7252:2025 / Z 7253:2025（JIS ルール）。国連 Rev.9 との違いだけ。S27 §3-2 の見本
ruleset "JP-JIS2025" version 1 extends "UN-Rev9" version 1 {
  meta {
    title "日本 JIS Z 7252:2025 / Z 7253:2025（JIS ルール）"
    valid_from 2025-12-25
    note "旧 JIS 2019 は 2030-12-24 まで使える（別のルールセット JP-JIS2019）"
  }

  // 採らない区分（Z 7252 表 1。結果は「区分に該当しない」）
  exclude acute.*.5 as not_classified
  exclude skin.3 as not_classified

  choose acute.category5 = exclude locked
  choose skin.category3 = exclude locked
  choose skin.subdivision = split locked
  // JIS は「分類結果に追記」とだけ（B.1.3.6 b) 2)）。置き場所は自社で変えてよい
  choose acute.unknown_statement = sds open
  // Gmiccs 式（0.1 % で分類できない）は自社のレイヤーで選べる
  choose acute.unknown_policy = correction open
  // Z 7253 6.3 c)「適用することが可能」＝任意
  choose label.h_omission = manufacturer locked

  // 成分に付いている区分 5 は国連の変換値（2500）でそのまま計算に入れる。日本の採用区分は製品の結果にだけ当てる
  // （上の exclude で読み替える。2026-10-17 決定）。変換値の表は差し替えない

  sds {
    // 濃度限界未満でも SDS に書く（Z 7252 B.4.3.4・B.6.3.2・B.7.3.2・B.8.4.4.1・B.9.3.4.1、Z 7253 D.4）
    list_ingredients_below_limit { carc.2 from 0.1 %; repr.* from 0.1 %; resp_sens.* from 0.1 %; skin_sens.* from 0.1 %; stot_se.2 from 1.0 %; stot_re.2 from 1.0 % }
    section 15 from regulations [ISHA, PRTR, PDSCL]
  }

  tests {
    test "区分 5 相当は区分に該当しない" {
      mixture { "A" 100 % ate.oral = 3000 mg/kg }
      expect { acute.oral not_classified }
    }
    test "区分 5 の成分は国連の変換値で計算に入り、結果だけ日本の採用区分で読み替える" {
      // 区分 5（ATE 2500）40 % ＋ 区分 4（ATE 500）60 % → ATEmix = 100 / (40/2500 + 60/500) = 735 → 区分 4
      mixture { "A" 40 % acute.oral 5; "B" 60 % acute.oral 4 }
      expect { acute.oral 4 }
    }
    test "区分 5 の成分だけなら国連では区分 5、日本では区分に該当しない" {
      mixture { "A" 100 % acute.oral 5 }
      expect { acute.oral not_classified }
    }
    test "皮膚 区分 3 相当は区分に該当しない" {
      mixture { "A" 12 % skin 3 }
      expect { skin not_classified }
    }
    test "皮膚 加成方式は国連と同じ" {
      mixture { "A" 0.5 % skin 1 flag relevant; "B" 6 % skin 2 }
      expect { skin 2 }
    }
  }
}
